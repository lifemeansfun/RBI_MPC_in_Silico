def build_macro_panel(output_path: Optional[Path] = None) -> pd.DataFrame:
    """
    Validates and persists the 25-meeting panel to Parquet.
    Every single record is verified against the Pydantic MacroSnapshot schema.
    """
    output_path = output_path or (PROJECT_ROOT / "data" / "processed" / "macro_panel.parquet")
    output_path.parent.mkdir(parents=True, exist_ok=True)

    validated_records = []
    for row in HISTORICAL_PANEL_DATA:
        try:
            # Validate schema
            snapshot = MacroSnapshot(
                meeting_date=row["meeting_date"],
                current_repo_rate_pct=row["current_repo_rate_pct"],
                cpi_headline_yoy_pct=row["cpi_headline_yoy_pct"],
                cpi_core_yoy_pct=row["cpi_core_yoy_pct"],
                cpi_food_yoy_pct=row.get("cpi_food_yoy_pct"),
                iip_growth_yoy_pct=row.get("iip_growth_yoy_pct"),
                gva_growth_yoy_pct=row.get("gva_growth_yoy_pct"),
                output_gap_pct=row.get("output_gap_pct"),
                system_liquidity_cr=row.get("system_liquidity_cr"),
                usd_inr_exchange_rate=row.get("usd_inr_exchange_rate"),
                brent_crude_usd_bbl=row.get("brent_crude_usd_bbl"),
                us_fed_funds_rate_pct=row.get("us_fed_funds_rate_pct"),
                monsoon_departure_lpa_pct=row.get("monsoon_departure_lpa_pct"),
                prev_stance=row["prev_stance"],
                real_rate_decision_bps=row.get("real_rate_decision_bps"),
                real_stance_decision=row.get("real_stance_decision"),
                real_dissenters=row.get("real_dissenters", []),
            )
            validated_records.append(snapshot.model_dump())
        except Exception as e:
            raise MacroDataMissingError(f"Validation failed for meeting {row.get('meeting_date')}: {e}")

    df = pd.DataFrame(validated_records)

    # Atomic write to parquet
    temp_path = output_path.parent / f".{output_path.name}.tmp"
    df.to_parquet(temp_path, index=False)
    temp_path.replace(output_path)

    print(f"[+] Successfully validated and built {output_path} with {len(df)} meetings.")
    return df


if __name__ == "__main__":
    build_macro_panel()
