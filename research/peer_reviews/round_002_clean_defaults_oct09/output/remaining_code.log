"""
Statement Extractor for RBI MPC Minutes.
Segments the 6 individual signed member statements from downloaded HTML minutes
and persists them as structured text files under data/processed/statements/{date}/{member_id}.txt.
Enforces strict defensive validation (minimum length checks, exactly 6 members present,
trimming of administrative boilerplate/signatures).
"""

import re
import logging
import hashlib
import json
from datetime import date, datetime
from pathlib import Path
from typing import Optional
from bs4 import BeautifulSoup

logger = logging.getLogger("rbi_mpc.extractor")
PROJECT_ROOT = Path(__file__).resolve().parent.parent.parent

# Standard member ID mapping and regex search patterns
MEMBER_PATTERNS = [
    {
        "member_id": "shashanka_bhide",
        "name": "Dr. Shashanka Bhide",
        "pattern": r"Statement\s+by\s+Dr\.?\s+Shashanka\s+Bhide",
    },
    {
        "member_id": "ashima_goyal",
        "name": "Dr. Ashima Goyal",
        "pattern": r"Statement\s+by\s+Dr\.?\s+Ashima\s+Goyal",
    },
    {
        "member_id": "jayanth_varma",
        "name": "Prof. Jayanth R. Varma",
        "pattern": r"Statement\s+by\s+Prof\.?\s+Jayanth\s+R\.?\s+Varma",
    },
    {
        "member_id": "rajiv_ranjan",
        "name": "Dr. Rajiv Ranjan",
        "pattern": r"Statement\s+by\s+Dr\.?\s+Rajiv\s+Ranjan",
    },
    {
        "member_id": "mridul_saggar",  # Executive Director Oct 2020 - May 2022
        "name": "Dr. Mridul K. Saggar",
        "pattern": r"Statement\s+by\s+Dr\.?\s+Mridul\s+(?:K\.?\s+)?Saggar",
    },
    {
        "member_id": "michael_patra",
        "name": "Dr. Michael Debabrata Patra",
        "pattern": r"Statement\s+by\s+Dr\.?\s+Michael\s+(?:Debabrata\s+|D\.?\s+)?Patra",
    },
    {
        "member_id": "shaktikanta_das",
        "name": "Shri Shaktikanta Das",
        "pattern": r"Statement\s+by\s+(?:Shri\s+)?Shaktikanta\s+Das",
    },
]

# Signature / administrative cutoff markers at the end of the document
ADMIN_CUTOFFS = [
    r"\(\s*[A-Z][a-z]+\s+[A-Z][a-z]+\s*\)\s*Chief\s+General\s+Manager",
    r"Press\s+Release\s*:\s*\d{4}-\d{4}",
    r"Editor\'s\s+Note",
]


class StatementExtractor:
    """Extracts, cleans, and defensively validates individual member statements from minutes HTML."""

    def __init__(self, processed_dir: Optional[Path] = None):
        self.processed_dir = processed_dir or (PROJECT_ROOT / "data" / "processed" / "statements_v2")
        self.processed_dir.mkdir(parents=True, exist_ok=True)

    @staticmethod
    def extract_meeting_date(soup: BeautifulSoup, default_date: str = "unknown") -> str:
        """Parses meeting end-date from title or text (e.g. 'August 8 to 10, 2023' -> 2023-08-10)."""
        return StatementExtractor.extract_meeting_metadata(soup)["decision_date"]

    @staticmethod
    def extract_meeting_metadata(soup: BeautifulSoup) -> dict:
        """Parse the meeting title and publication header independently.

        No full-document date search may accidentally use the later press-release date.
        """
        months = {name.lower(): n for n, name in enumerate(
            ("January", "February", "March", "April", "May", "June", "July", "August",
             "September", "October", "November", "December"), 1)}
        titles = set()
        for node in soup.find_all(["strong", "b", "p", "td"]):
            text = " ".join(node.get_text(" ", strip=True).split())
            if text.startswith("Minutes of the Monetary Policy Committee Meeting") and len(text) < 180:
                titles.add(text)
        if len(titles) != 1:
            raise ValueError("Expected one unambiguous MPC meeting title")
        title = titles.pop()
        pattern = r"(" + "|".join(months) + r")\s+([\d\s,\-–andto]+),\s*(\d{4})$"
        match = re.search(pattern, title, re.IGNORECASE)
        if not match:
            raise ValueError(f"Unrecognized meeting title: {title}")
        days = [int(x) for x in re.findall(r"\d+", match.group(2))]
        year, month = int(match.group(3)), months[match.group(1).lower()]
        start, decision = date(year, month, min(days)), date(year, month, max(days))
        text = " ".join(soup.get_text(" ", strip=True).split())
        header = text[:text.index(title)]
        published = re.findall(r"Date\s*:\s*([A-Za-z]+\s+\d{1,2},\s*\d{4})", header)
        if len(published) != 1:
            raise ValueError("Missing or ambiguous minutes publication header")
        for fmt in ("%b %d, %Y", "%B %d, %Y"):
            try:
                publication = datetime.strptime(published[0], fmt).date()
                break
            except ValueError:
                continue
        else:
            raise ValueError("Unrecognized publication date")
        if publication < decision:
            raise ValueError("Minutes publication predates decision")
        return {"title": title, "meeting_start_date": start.isoformat(),
                "decision_date": decision.isoformat(), "publication_date": publication.isoformat(),
                "availability_basis": "RBI press-release header date; conservatively available after that day"}

    def process_html_file(self, html_path: Path) -> dict[str, str]:
        """
        Parses a single HTML minutes document and returns {member_id: statement_text}.
        Validates that statements meet quality, length, and presence thresholds.
        """
        try:
            with open(html_path, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
        except Exception as e:
            logger.error("Failed to read HTML file %s: %s", html_path, e)
            return {}

        soup = BeautifulSoup(content, "html.parser")
        metadata = self.extract_meeting_metadata(soup)
        meeting_date = metadata["decision_date"]
        full_text = soup.get_text()

        # Locate all member heading occurrences
        member_matches = []
        for mem in MEMBER_PATTERNS:
            m = re.search(mem["pattern"], full_text, re.IGNORECASE)
            if m:
                member_matches.append({
                    "member_id": mem["member_id"],
                    "name": mem["name"],
                    "start_idx": m.start(),
                })

        if not member_matches:
            logger.warning("No member statement headings found in %s", html_path.name)
            return {}

        # Sort by appearance order in document
        member_matches = sorted(member_matches, key=lambda x: x["start_idx"])

        # Determine cutoff for the final statement (remove CGM signatures / administrative footers)
        doc_end = len(full_text)
        last_start = member_matches[-1]["start_idx"]
        tail_text = full_text[last_start:]
        for cutoff_pat in ADMIN_CUTOFFS:
            cutoff_m = re.search(cutoff_pat, tail_text, re.IGNORECASE)
            if cutoff_m:
                doc_end = last_start + cutoff_m.start()
                break

        extracted_statements: dict[str, str] = {}
        for i in range(len(member_matches)):
            start = member_matches[i]["start_idx"]
            end = member_matches[i + 1]["start_idx"] if i + 1 < len(member_matches) else doc_end
            raw_statement = full_text[start:end].strip()

            # Clean extra whitespace
            clean_statement = re.sub(r"\n\s*\n+", "\n\n", raw_statement)
            clean_statement = re.sub(r"[ \t]+", " ", clean_statement).strip()

            words = clean_statement.split()
            member_id = member_matches[i]["member_id"]
            if len(words) >= 80:  # Valid statement length
                extracted_statements[member_id] = clean_statement
            else:
                logger.warning(
                    "Statement for %s on %s has only %d words (<80 threshold). Discarded.",
                    member_id, meeting_date, len(words)
                )

        # Defensive validation: check if exactly 6 members are present
        if len(extracted_statements) != 6:
            raise ValueError(f"Meeting {meeting_date} has {len(extracted_statements)} statements, expected 6")

        # Persist extracted statements atomically
        date_dir = self.processed_dir / meeting_date
        date_dir.mkdir(parents=True, exist_ok=True)
        for member_id, stmt in extracted_statements.items():
            file_path = date_dir / f"{member_id}.txt"
            payload = stmt.encode("utf-8")
            if file_path.exists() and file_path.read_bytes() != payload:
                raise FileExistsError(f"Refusing to overwrite a different statement: {file_path}")
            if not file_path.exists():
                with file_path.open("xb") as f:
                    f.write(payload)
        metadata.update({"source_file": str(html_path.resolve().relative_to(PROJECT_ROOT)),
                         "source_sha256": hashlib.sha256(html_path.read_bytes()).hexdigest(),
                         "statement_sha256": {m: hashlib.sha256(s.encode()).hexdigest()
                                               for m, s in extracted_statements.items()}})
        meta_path = date_dir / "source_manifest.json"
        payload = (json.dumps(metadata, sort_keys=True, indent=2) + "\n").encode()
        if meta_path.exists() and meta_path.read_bytes() != payload:
            raise FileExistsError(f"Conflicting statement metadata: {meta_path}")
        if not meta_path.exists():
            with meta_path.open("xb") as f:
                f.write(payload)

        print(f"[+] Processed {html_path.name} -> Meeting Date: {meeting_date} | Extracted: {len(extracted_statements)}/6 statements.")
        return extracted_statements


if __name__ == "__main__":
    extractor = StatementExtractor()
    raw_dir = PROJECT_ROOT / "data" / "raw" / "minutes_html"
    total_meetings = 0
    total_statements = 0
    for html_file in sorted(raw_dir.glob("*.html")):
        res = extractor.process_html_file(html_file)
        if res:
            total_meetings += 1
            total_statements += len(res)
    print(f"\n[Extraction Summary] Processed {total_meetings} meetings, total {total_statements} member statements extracted.")
"""
Data Perturbation and Entity Masking Protocols (Mitigation for Data Leakage).
Implements the "Entity-Masked Perturbation" protocol to verify if the LLM is reasoning or memorizing.
"""

import copy
import re
from src.schemas.macro_schema import MacroMeetingSnapshot

class DataPerturbator:
    """
    Handles systematic shocking of macroeconomic data and masking of identifying entities.
    """

    ENTITY_MAP = {
        "Reserve Bank of India": "Central Bank of Country X",
        "RBI": "Central Bank",
        "India": "Country X",
        "Shaktikanta Das": "Chairperson A",
        "Michael Patra": "Internal Member B",
        "Rajiv Ranjan": "Internal Member C",
        "Shashanka Bhide": "External Member D",
        "Ashima Goyal": "External Member E",
        "Jayanth Varma": "External Member F",
        "Jayanth R. Varma": "External Member F",
        "INR": "LCU (Local Currency Unit)",
        "Crore": "Billion",
        "Monsoon": "Seasonal Weather",
        "LPA": "Long Period Average",
    }

    @staticmethod
    def apply_macro_shock(snapshot: MacroMeetingSnapshot, 
                          cpi_shock: float = 0.0, 
                          food_shock: float = 0.0,
                          fed_shock: float = 0.0) -> MacroMeetingSnapshot:
        """
        Injects a structural macroeconomic shock into the snapshot to test reasoning vs memorization.
        """
        perturbed = snapshot.model_copy(deep=True)
        perturbed.cpi_headline_yoy_pct += cpi_shock
        
        if perturbed.cpi_core_yoy_pct is not None:
            # Assume core inflation absorbs a fraction of headline shock if it's broad based
            pass 
            
        if perturbed.cpi_food_yoy_pct is not None and food_shock != 0.0:
            perturbed.cpi_food_yoy_pct += food_shock
            
        if perturbed.us_fed_funds_rate_pct is not None and fed_shock != 0.0:
            perturbed.us_fed_funds_rate_pct += fed_shock
            
        return perturbed

    @staticmethod
    def mask_entities_in_text(text: str) -> str:
        """
        Replaces all known specific institutional identifiers with generic equivalents.
        """
        masked_text = text
        # Process longer strings first to avoid partial replacements
        sorted_keys = sorted(DataPerturbator.ENTITY_MAP.keys(), key=len, reverse=True)
        for key in sorted_keys:
            replacement = DataPerturbator.ENTITY_MAP[key]
            # Use regex with word boundaries where appropriate, but simple replace is often fine for names
            pattern = re.compile(re.escape(key), re.IGNORECASE)
            masked_text = pattern.sub(replacement, masked_text)
            
        # Additional cleanup
        masked_text = masked_text.replace("Rs.", "LCU")
        masked_text = masked_text.replace("Rupee", "Local Currency")
        masked_text = masked_text.replace("Rupees", "Local Currency")
        
        return masked_text

    @staticmethod
    def get_masked_prompt(snapshot: MacroMeetingSnapshot) -> str:
        """
        Generates the standard prompt text from a snapshot, but masks all entities.
        """
        raw_prompt = snapshot.to_prompt_text()
        return DataPerturbator.mask_entities_in_text(raw_prompt)

            if subset in ('all','calibration'):
                raise GenerationProvenanceError('Frozen calibration personas cannot be evaluated on earlier meetings as available information. Use an explicitly labeled diagnostic or dated rolling fit.')
        selected = [s for s in snapshots if subset == 'all' or (s.meeting_date <= '2023-04-06') == (subset == 'calibration')]
        if max_meetings is not None:
            if type(max_meetings) is not int or max_meetings < 1:
                raise ValueError('Invalid meeting limit')
            selected = selected[:max_meetings]
        provider = self.orchestrator.client.provider
        roster_by_meeting = {s.meeting_date:[p.member_id for p in self.load_roster_for_date(s.meeting_date)] for s in selected}
        inputs = prepare_inputs(selected, [self._truth_by_date[s.meeting_date] for s in selected],
                    self.config.model_dump(), {p.stem:yaml.safe_load(p.read_text()) for p in sorted(self.personas_dir.glob('*.yaml'))},
                    self.personas_dir/'corpus_manifest.json', PROJECT_ROOT, research_mode=self.research_mode)
        study_settings = {'study_manifest_version':2, 'data_hash':file_hash(self.macro_panel_path),'truth_hash':file_hash(self.truth_path),
                          'persona_hash':content_hash({p.name:file_hash(p) for p in sorted(self.personas_dir.glob('*.yaml'))}),
                          'config_hash':content_hash(self.config.model_dump()),'code_hash':code_identity(),
                          'n_replicates':self.n_replicates,'seed_base':self.seed_base,'provider':provider,
                          'model':model or self.config.run.dev_model,'temperature':temperature if temperature is not None else self.config.run.temperature,
                          'meetings':[s.meeting_date for s in selected],'condition':self.condition_id,
                          'control':self.control_mode,'mask_identity':self.mask_identity,'mask_date':self.mask_date,
                          'fragmentation_policy':self.fragmentation_policy,'evidence_scope':'exposed retrospective study',
                          'source_validation_required':self.research_mode, 'roster_by_meeting':roster_by_meeting,
                          'governor_id':'shaktikanta_das',
                          'generation_settings':self.orchestrator.generation_settings(model=model, temperature=temperature),
                          'frozen_inputs_hashes':{name:content_hash(payload) for name,payload in inputs.items()}}
        self.experiment_id = self.experiment_id or 'study_'+content_hash(study_settings)[:20]
        # A provider smoke/mock run cannot acquire a live label.
        write_immutable(self.results_dir/self.experiment_id/self.condition_id/'study_manifest.json', study_settings, replay=resume)
        self._study_manifest = study_settings
        inputs_dir = self.results_dir/self.experiment_id/self.condition_id/'inputs'
        persist_inputs(inputs_dir, inputs, replay=resume)
        records = []
        for snapshot in selected:
            personas = self.load_roster_for_date(snapshot.meeting_date)
            for replicate in range(1,self.n_replicates+1):
                identity = self._identity(snapshot, personas, replicate, model, temperature)
                saved = self.checkpoints.load(identity) if resume else None
                if saved is not None:
                    record = saved['payload']
                else:
                    record = await self.run_meeting_backtest(snapshot, model, temperature, replicate_id=replicate)
                records.append(record)
        joined = []
        for record in records:
            truth = self._truth_by_date[record['meeting_date']]
            joined.append({**record,'actual_rate_bps':truth['actual_rate_bps'],'actual_stance':truth['actual_stance'],
                           'actual_rate_dissenters':truth['rate_dissenters'],'actual_stance_dissenters':truth['stance_dissenters']})
        path = self.results_dir/self.experiment_id/self.condition_id
        write_immutable(path/'predictions.json',joined,replay=resume)
        metrics = {str(rep):self.compute_aggregate_metrics(pd.DataFrame([r for r in joined if r['replicate_id']==rep]))
                   for rep in range(1,self.n_replicates+1)}
        write_immutable(path/'metrics_by_replicate.json',metrics,replay=resume)
        return pd.DataFrame(joined)

    @staticmethod
    def compute_aggregate_metrics(df):
        if df.empty or df['meeting_date'].duplicated().any():
            raise ValueError('Metrics require one aligned row per meeting, not pooled pseudo-replicates')
        pred_rate = list(df['sim_rate_dissenters']); true_rate = list(df['actual_rate_dissenters'])
        pred_stance = list(df['sim_stance_dissenters']); true_stance = list(df['actual_stance_dissenters'])
        summary = MetricsEvaluator.evaluate_panel([int(x) for x in df['sim_rate_bps']], [int(x) for x in df['actual_rate_bps']],
            list(df['sim_stance']),list(df['actual_stance']),
            [sorted(set(a)|set(b)) for a,b in zip(pred_rate,pred_stance)],
            [sorted(set(a)|set(b)) for a,b in zip(true_rate,true_stance)],
            predicted_rate_dissenters=pred_rate,true_rate_dissenters=true_rate,
            predicted_stance_dissenters=pred_stance,true_stance_dissenters=true_stance)
        return summary.model_dump()


