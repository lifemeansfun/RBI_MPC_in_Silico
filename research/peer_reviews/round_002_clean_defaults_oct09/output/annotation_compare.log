first_columns ['meeting_id', 'decision_date', 'member_id', 'member_name', 'published_rate_vote_cell', 'published_rate_reduction_magnitude_bps', 'preferred_rate_change_bps', 'rate_choice_disagrees_with_resolution', 'rate_evidence_basis', 'rate_source_evidence', 'explicit_formal_stance_vote', 'explicit_formal_stance_vote_disagrees_with_resolution', 'formal_stance_evidence_basis', 'formal_stance_excerpts', 'stated_stance_preference', 'stated_stance_preference_disagrees_with_resolution', 'stance_position_source_excerpts', 'documented_prior_reservation', 'documented_guidance_qualification', 'reservation_or_guidance_candidate_excerpts', 'candidate_excerpt_selection_basis', 'reservation_and_guidance_status', 'annotation_status', 'ambiguity_note']
first_row {'meeting_id': 'rbi_mpc_2024-10-09', 'decision_date': '2024-10-09', 'member_id': 'nagesh_kumar', 'member_name': 'Nagesh Kumar', 'published_rate_vote_cell': 'No', 'published_rate_reduction_magnitude_bps': '', 'preferred_rate_change_bps': '-25', 'rate_choice_disagrees_with_resolution': 'True', 'rate_evidence_basis': 'official rate table; ascribed choice/magnitude, not narrative prediction', 'rate_source_evidence': '{"source_id": "rbi_prid_58958", "pointer": "Voting on the Resolution table", "table_header": ["Member", "Vote"], "verbatim_cells": ["Dr. Nagesh Kumar", "No"], "source_sha256": "916ee73dcafdb078ef2fcef2e3d891eb8d978248e94ce1882039fc02433ad85b"}', 'explicit_formal_stance_vote': 'neutral', 'explicit_formal_stance_vote_disagrees_with_resolution': 'False', 'formal_stance_evidence_basis': 'resolution explicitly attributes neutral stance votes to all six named members', 'formal_stance_excerpts': '[{"text": "10. Dr. Nagesh Kumar, Shri Saugata Bhattacharya, Professor Ram Singh, Dr. Rajiv Ranjan, Dr. Michael Debabrata Patra and Shri Shaktikanta Das voted for a change in stance from withdrawal of accommodation to ‘neutral’ and to remain unambiguously focused on a durable alignment of inflation with the target, while supporting growth.", "pointer": "paragraph 10", "source_id": "rbi_prid_58958", "source_url": "https://www.rbi.org.in/Scripts/BS_PressReleaseDisplay.aspx?prid=58958", "source_path": "raw/rbi_prid_58958.html", "source_sha256": "916ee73dcafdb078ef2fcef2e3d891eb8d978248e94ce1882039fc02433ad85b"}]', 'stated_stance_preference': 'neutral', 'stated_stance_preference_disagrees_with_resolution': 'False', 'stance_position_source_excerpts': '[{"text": "15. The job creation imperative for India’s youthful population has pushed the Government to focus attention on the manufacturing sector which has the potential to create decent jobs not only directly but also indirectly, especially for semi-skilled and unskilled workers. Several reforms and policy measures such as PLI have been taken over the past decade as a part of the ‘Make-in-India’. India is not alone in pushing the manufacturing sector. The US, until recently the greatest champion of free markets, for instance, is pushing industrial policy aggressively with a trinity of the Inflation Reduction Act, the CHIPS and the Science Act, and the Infrastructure Investment and Jobs Act adopted in 2022 which have collectively put more than a trillion dollars on the table to be handed out to industry in incentives and tax breaks, besides heavy tariffs imposed on the imports from China to protect the domestic industry. The EU is following the same playbook.", "pointer": "paragraph 15", "source_id": "rbi_prid_58958", "source_url": "https://www.rbi.org.in/Scripts/BS_PressReleaseDisplay.aspx?prid=58958", "source_path": "raw/rbi_prid_58958.html", "source_sha256": "916ee73dcafdb078ef2fcef2e3d891eb8d978248e94ce1882039fc02433ad85b"}, {"text": "22. Given that inflationary expectations have been successfully anchored, and industrial demand in both domestic as well as export markets is flagging, a rate cut could help to revive demand and help boost private investment. I believe that it is an opportune moment for RBI to start the process of normalizing the monetary policy. In view of these observations, I vote for a 25 basis point cut in the repo rate and the adoption of a neutral stance in the monetary policy.", "pointer": "paragraph 22", "source_id": "rbi_prid_58958", "source_url": "https://www.rbi.org.in/Scripts/BS_PressReleaseDisplay.aspx?prid=58958", "source_path": "raw/rbi_prid_58958.html", "source_sha256": "916ee73dcafdb078ef2fcef2e3d891eb8d978248e94ce1882039fc02433ad85b"}]', 'documented_prior_reservation': '', 'documented_guidance_qualification': '', 'reservation_or_guidance_candidate_excerpts': '[]', 'candidate_excerpt_selection_basis': 'lexical retrieval aid only; not exhaustive or a disagreement label', 'reservation_and_guidance_status': 'positive curated April case; other rows unassessed, not negative', 'annotation_status': 'single source-collector extraction; independent double coding not performed', 'ambiguity_note': ''}
second_row {'literal_rate_ballot': {'value': 'No', 'status': 'documented_literal_table_cell', 'evidence': [{'source_id': 'rbi_prid_58958', 'source_url': 'https://www.rbi.org.in/Scripts/BS_PressReleaseDisplay.aspx?prid=58958', 'raw_path': 'raw/rbi_prid_58958.html', 'snapshot_absolute_path': '/var/folders/wh/rvj5dycx0zgbk951gfhl9jb80000gn/T/rbi_source_doublecode_oct08_rti8uqqx/raw/rbi_prid_58958.html', 'source_sha256': '916ee73dcafdb078ef2fcef2e3d891eb8d978248e94ce1882039fc02433ad85b', 'publication_date': '2024-10-23', 'evidence_kind': 'rate_vote_table_row', 'zero_based_p_index': None, 'raw_character_start': 43269, 'raw_character_end_exclusive': 43357, 'excerpt': 'Dr. Nagesh Kumar No', 'raw_html_excerpt': '<tr>          <td>Dr. Nagesh Kumar</td>          <td align="center">No</td>        </tr>', 'raw_html_excerpt_utf8_sha256': 'f01f2f03891d616db5f4ef92849aa458a49c56427131d6981a95e8b9f4b2693e'}]}, 'final_member_rate_choice_delta_bps': {'value': -25, 'status': 'documented_member_choice', 'evidence': [{'source_id': 'rbi_prid_58958', 'source_url': 'https://www.rbi.org.in/Scripts/BS_PressReleaseDisplay.aspx?prid=58958', 'raw_path': 'raw/rbi_prid_58958.html', 'snapshot_absolute_path': '/var/folders/wh/rvj5dycx0zgbk951gfhl9jb80000gn/T/rbi_source_doublecode_oct08_rti8uqqx/raw/rbi_prid_58958.html', 'source_sha256': '916ee73dcafdb078ef2fcef2e3d891eb8d978248e94ce1882039fc02433ad85b', 'publication_date': '2024-10-23', 'evidence_kind': 'paragraph', 'zero_based_p_index': 35, 'raw_character_start': 50414, 'raw_character_end_exclusive': 50893, 'excerpt': '22. Given that inflationary expectations have been successfully anchored, and industrial demand in both domestic as well as export markets is flagging, a rate cut could help to revive demand and help boost private investment. I believe that it is an opportune moment for RBI to start the process of normalizing the monetary policy. In view of these observations, I vote for a 25 basis point cut in the repo rate and the adoption of a neutral stance in the monetary policy.', 'raw_html_excerpt': '<p>22. Given that inflationary expectations have been successfully anchored, and industrial demand in both domestic as well as export markets is flagging, a rate cut could help to revive demand and help boost private investment. I believe that it is an opportune moment for RBI to start the process of normalizing the monetary policy. In view of these observations, I vote for a 25 basis point cut in the repo rate and the adoption of a neutral stance in the monetary policy.</p>', 'raw_html_excerpt_utf8_sha256': 'c123d6639046ec1ab6a8a3afae25e027d7c5d712f64b4883cf62bb37287d1818'}]}, 'formal_stance_vote': {'value': 'neutral', 'status': 'documented_explicit_vote_narrative', 'evidence': [{'source_id': 'rbi_prid_58958', 'source_url': 'https://www.rbi.org.in/Scripts/BS_PressReleaseDisplay.aspx?prid=58958', 'raw_path': 'raw/rbi_prid_58958.html', 'snapshot_absolute_path': '/var/folders/wh/rvj5dycx0zgbk951gfhl9jb80000gn/T/rbi_source_doublecode_oct08_rti8uqqx/raw/rbi_prid_58958.html', 'source_sha256': '916ee73dcafdb078ef2fcef2e3d891eb8d978248e94ce1882039fc02433ad85b', 'publication_date': '2024-10-23', 'evidence_kind': 'paragraph', 'zero_based_p_index': 21, 'raw_character_start': 42390, 'raw_character_end_exclusive': 42726, 'excerpt': '10. Dr. Nagesh Kumar, Shri Saugata Bhattacharya, Professor Ram Singh, Dr. Rajiv Ranjan, Dr. Michael Debabrata Patra and Shri Shaktikanta Das voted for a change in stance from withdrawal of accommodation to ‘neutral’ and to remain unambiguously focused on a durable alignment of inflation with the target, while supporting growth.', 'raw_html_excerpt': '<p>10. Dr. Nagesh Kumar, Shri Saugata Bhattacharya, Professor Ram Singh, Dr. Rajiv Ranjan, Dr. Michael Debabrata Patra and Shri Shaktikanta Das voted for a change in stance from withdrawal of accommodation to ‘neutral’ and to remain unambiguously focused on a durable alignment of inflation with the target, while supporting growth.</p>', 'raw_html_excerpt_utf8_sha256': '20c64b65af0f6dbf67c6c5832f98051ef4117384765a7f522c3e3c166e4f6c01'}], 'literal_yes_no_ballot': None}}
