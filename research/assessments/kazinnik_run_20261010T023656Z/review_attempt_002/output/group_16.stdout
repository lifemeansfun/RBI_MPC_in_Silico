"""Strong, reproducible historical baselines; only published prior truth is usable."""
from collections import Counter
from datetime import date
import hashlib
import json
from src.validation.metrics import MetricsEvaluator


def fit_dissent_baseline(calibration_truth, cutoff="2023-04-06", *, information_cutoff="2023-04-30"):
    if date.fromisoformat(cutoff).isoformat() != cutoff or date.fromisoformat(information_cutoff).isoformat() != information_cutoff:
        raise ValueError('Baseline cutoffs must be ISO calendar dates')
    if not calibration_truth or any(row['meeting_date'] > cutoff for row in calibration_truth):
        raise ValueError('Holdout or empty truth in calibration')
    if len({row['meeting_date'] for row in calibration_truth}) != len(calibration_truth):
        raise ValueError('Duplicate calibration meeting')
    for row in calibration_truth:
        meeting, publication = date.fromisoformat(row['meeting_date']), date.fromisoformat(row['publication_date'])
        if publication < meeting or row['publication_date'] >= information_cutoff:
            raise ValueError('Calibration labels are unavailable at the declared selection freeze')
    result = {'cutoff': cutoff, 'information_cutoff':information_cutoff,
              'method': 'best constant dissent set per channel by calibration F1 then exact-match',
              'selection_status': 'calibration only; cohort-specific',
              'calibration_hash': hashlib.sha256(json.dumps(calibration_truth, sort_keys=True).encode()).hexdigest()}
    for channel in ('rate_dissenters', 'stance_dissenters'):
        candidates = sorted({tuple(sorted(row[channel])) for row in calibration_truth})
        truth = [row[channel] for row in calibration_truth]
        scored = []
        for candidate in candidates:
            precision, recall, f1, exact = MetricsEvaluator.compute_dissent_f1([candidate] * len(truth), truth)
            scored.append((f1 if f1 is not None else -1, exact, candidate))
        # Lexical tie-break is predetermined and recorded; no evaluation labels used.
        result[channel] = list(max(scored, key=lambda item: (item[0], item[1], tuple(item[2])))[2])
    return result


def baseline_predictions(snapshots, truth, frozen_dissent):
    by_date = {row['meeting_date']: row for row in truth}
    if len(by_date) != len(truth):
        raise ValueError('Duplicate truth meeting')
    rows = []
    for snapshot in snapshots:
        # Entire minutes publication day precedes the meeting-start cutoff.
        cutoff = snapshot.information_cutoff.date().isoformat() if snapshot.information_cutoff else snapshot.meeting_date
        available = sorted([r for r in truth if r['publication_date'] < cutoff], key=lambda r:r['meeting_date'])
        prior = available[-1] if available else None
        for name in ('hold_previous_stance', 'lag_persistence', 'calibration_constant_dissent'):
            rate = prior['actual_rate_bps'] if name == 'lag_persistence' and prior else 0
            stance = prior['actual_stance'] if name == 'lag_persistence' and prior else snapshot.prev_stance
            rate_dissent = prior['rate_dissenters'] if name == 'lag_persistence' and prior else []
            stance_dissent = prior['stance_dissenters'] if name == 'lag_persistence' and prior else []
            if name == 'calibration_constant_dissent':
                if snapshot.meeting_date <= frozen_dissent['cutoff'] or cutoff < frozen_dissent['information_cutoff']:
                    raise ValueError('Fitted baseline evaluated inside calibration')
                rate_dissent, stance_dissent = frozen_dissent['rate_dissenters'], frozen_dissent['stance_dissenters']
            rows.append({'meeting_date':snapshot.meeting_date, 'baseline':name, 'rate_bps':rate,
                         'stance':stance, 'rate_dissenters':list(rate_dissent), 'stance_dissenters':list(stance_dissent),
                         'source_prior_meeting':prior['meeting_date'] if prior else None,
                         'evidence_type':'deterministic_baseline'})
    return rows
"""
Pydantic schema for MPC Member Personas.
Validates the structure of persona YAML profiles and prompt generation.
"""

from typing import Optional, Literal
from pydantic import BaseModel, Field, ConfigDict
from src.schemas.decision_space import RATE_ACTIONS_BPS, STANCE_ACTIONS, StanceType


class MemberPersona(BaseModel):
    model_config = ConfigDict(extra="forbid", allow_inf_nan=False)

    member_id: str
    name: str
    role: str = Field(description="Governor | Deputy Governor | Executive Director | External Member")
    is_internal: bool = Field(description="True if RBI official, False if external government appointee")
    tenure: str = Field(description="e.g. 2020-10 to 2024-10")
    hawk_dove_score: float = Field(
        ge=-1.0, le=1.0,
        description="Hawk (+1.0) vs Dove (-1.0) score based on historical statements"
    )
    stance_bias: StanceType = Field(
        default="withdrawal_of_accommodation",
        description="Historical tendency on stance (withdrawal_of_accommodation, neutral, accommodative)"
    )
    voting_priority: str = Field(
        description="Summary of primary monetary policy objective and behavioral posture"
    )
    biography: Optional[str] = Field(
        default=None,
        description="Double-blind qualitative abstract of academic/policy background for zero-shot prompting."
    )
    key_themes: list[str] = Field(
        default_factory=list,
        description="3-5 recurring economic concepts or arguments cited in official minutes"
    )
    system_prompt_override: Optional[str] = None
    calibration_cutoff: Optional[str] = None
    corpus_manifest_hash: Optional[str] = Field(default=None, pattern=r"^[0-9a-f]{64}$")
    provenance_status: Literal["legacy_unverified", "dated_corpus", "assumed"] = "legacy_unverified"

    def build_system_prompt(self, zero_shot_biography: bool = False, mask_identity: bool = False) -> str:
        """Generates the grounded system prompt for the LLM agent.
        If zero_shot_biography=True, explicit quantitative parameters are hidden to mitigate prompt endogeneity.
        """
        themes_str = "\n".join(f"- {theme}" for theme in self.key_themes)
        role_type = "Internal RBI Official" if self.is_internal else "External Academic / Expert Appointee"
        
        prompt_lines = [
            f"You are {'a simulated committee member' if mask_identity else self.name}, serving in a simulated RBI Monetary Policy Committee (MPC).",
            f"Member ID: {self.member_id}",
            f"Your institutional role: {self.role} ({role_type}).",
            f"Persona evidence status: {self.provenance_status}.",
            "",
            "=== YOUR ECONOMIC PHILOSOPHY & MONETARY POSTURE ==="
        ]

        if zero_shot_biography and self.biography:
            prompt_lines.extend([
                "Supplied biography (its availability must be established by the experiment):",
                f"{self.biography}",
                "",
                "Use only this supplied background, without recalling historical meeting outcomes."
            ])
        else:
            prompt_lines.extend([
                f"- Lexical orientation statistic: {self.hawk_dove_score:+.2f} (Scale: -1.0 Dove to +1.0 Hawk; not a validated structural preference)",
                f"- Underlying Policy Priority: {self.voting_priority}",
                "- Recurring Themes in Your Historical Signed Minutes:",
                themes_str
            ])

        prompt_lines.extend([
            "",
            "=== INSTITUTIONAL INSTRUCTIONS & BEHAVIORAL RULES ===",
            "1. You are deliberating in a simulation. Your outputs are generated statements, not actual official minutes.",
            "2. Ground all arguments in Indian macroeconomic reality: CPI-Combined inflation (RBI 4.00% target with +/-2% band), monsoon progress and food price spikes, growth recovery, system liquidity, and US Fed policy spillovers.",
            "3. Maintain your authentic personal perspective. Do not automatically collapse into consensus with the Governor unless the macroeconomic evidence genuinely warrants it.",
            "4. You must cast votes strictly from the authorized action sets:",
            "   - Rate Change: " + ", ".join(f"{a:+d}" if a > 0 else str(a) for a in RATE_ACTIONS_BPS) + " bps",
            "   - Policy Stance: " + ", ".join(repr(s) for s in STANCE_ACTIONS),
            "5. Always respond in the requested structured JSON format without markdown wrapping or conversational preambles."
        ])
        
        return "\n".join(prompt_lines).strip()
