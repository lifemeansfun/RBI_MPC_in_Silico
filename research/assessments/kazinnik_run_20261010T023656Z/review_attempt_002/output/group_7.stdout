"""Voting under RBI Act §45ZI(5),(7),(8), with explicit simulator assumptions.

Primary source: https://dea.gov.in/files/acts_documents/Chapter_IIIF_RBI_Act.pdf
§45ZL concerns publication of minutes, not casting votes. A six-voter simulation
is stricter than legal quorum. Multiaction fragmentation resolution is synthetic,
because a categorical menu is not the Act's vote on a specified question.
"""

from collections import Counter
from dataclasses import dataclass
from typing import Any, Sequence, Optional

from src.schemas.decision_space import RATE_ACTIONS_BPS, STANCE_ACTIONS, validate_rate_action


@dataclass(frozen=True)
class AggregationResult:
    winning_action: Any
    vote_tally: dict[Any, int]
    tie_broken_by_governor: bool
    majority_achieved: bool
    dissenting_members: list[str]
    synthetic_resolution: bool = False
    resolution_policy: str = "majority"
    full_roster_simulation: bool = True
    members_present: int = 6


class InstitutionalRuleEngine:
    """Stateless voting; authority and synthetic choices remain separately labeled."""

    @staticmethod
    def validate_attendance(
        member_votes: dict[str, Any], governor_id: str, *, full_roster: bool = True,
        deputy_governor_id: Optional[str] = None,
        attending_member_ids: Optional[Sequence[str]] = None,
    ) -> None:
        if full_roster and len(member_votes) != 6:
            raise ValueError(f"Full-roster simulation requires exactly 6 member votes; received {len(member_votes)}")
        attendees = list(attending_member_ids) if attending_member_ids is not None else list(member_votes)
        if any(not isinstance(m, str) or not m for m in attendees) or len(set(attendees)) != len(attendees):
            raise ValueError("Attending member identities must be distinct nonempty strings")
        if any(not isinstance(m, str) or not m for m in member_votes):
            raise ValueError("Voter identities must be nonempty strings")
        if not set(member_votes).issubset(attendees):
            raise ValueError("A vote cannot be cast by an absent member")
        if not 4 <= len(attendees) <= 6:
            raise ValueError("RBI Act §45ZI(5) quorum requires 4 to 6 attending members")
        if full_roster and set(attendees) != set(member_votes):
            raise ValueError("Full-roster simulation requires all six attendees to vote")
        if governor_id not in attendees:
            if full_roster:
                raise ValueError(f"Governor {governor_id} must be present in member votes")
            if deputy_governor_id is None or deputy_governor_id not in attendees:
                raise ValueError("Quorum must include Governor, or Deputy Governor in Governor's absence")
        if not member_votes:
            raise ValueError("At least one member present must vote")

    @classmethod
    def _aggregate(
        cls, member_votes: dict[str, Any], governor_id: str, valid_actions: Sequence[Any], *,
        kind: str, full_roster: bool, deputy_governor_id: Optional[str],
        attending_member_ids: Optional[Sequence[str]], fragmentation_policy: str, prior_action: Any,
    ) -> AggregationResult:
        cls.validate_attendance(member_votes, governor_id, full_roster=full_roster,
                                deputy_governor_id=deputy_governor_id,
                                attending_member_ids=attending_member_ids)
        if fragmentation_policy not in ("reject", "legacy_synthetic", "status_quo"):
            raise ValueError("Unknown fragmentation policy")
        for member, vote in member_votes.items():
            if kind == "rate":
                try:
                    validate_rate_action(vote)
                except ValueError as exc:
                    raise ValueError(f"Vote {vote!r} by {member} is outside valid action set: {valid_actions}") from exc
            if vote not in valid_actions:
                raise ValueError(f"Vote {vote!r} by {member} is outside valid action set: {valid_actions}")
        tally = dict(Counter(member_votes.values()))
        top_action, top_count = max(tally.items(), key=lambda item: item[1])
        majority = top_count > len(member_votes) / 2
        casting = False
        synthetic = False
        policy = "majority"
        if majority:
            winner = top_action
        elif len(tally) == 2 and len(set(tally.values())) == 1 and governor_id in member_votes:
            winner = member_votes[governor_id]
            casting = True
            policy = "governor_casting_vote_45ZI_8"
        else:
            if fragmentation_policy == "reject":
                raise ValueError("No majority or Governor-resolvable binary equality; declare a synthetic resolution policy")
            synthetic = True
            policy = fragmentation_policy
            if fragmentation_policy == "status_quo":
                if prior_action not in valid_actions:
                    raise ValueError("Status-quo resolution requires a valid prior action")
                winner = prior_action
            else:
                if governor_id not in member_votes:
                    raise ValueError("Legacy synthetic fragmentation requires a Governor ballot")
                gov_action = member_votes[governor_id]
                if kind == "rate":
                    weighted = sorted([*member_votes.values(), gov_action])
                    winner = weighted[len(weighted) // 2]
                    policy = "synthetic_governor_weighted_median"
                else:
                    winner = top_action if list(tally.values()).count(top_count) == 1 else gov_action
                    policy = "synthetic_plurality_governor_priority"
        return AggregationResult(
            winning_action=winner, vote_tally=tally, tie_broken_by_governor=casting,
            majority_achieved=majority,
            dissenting_members=[m for m, action in member_votes.items() if action != winner],
            synthetic_resolution=synthetic, resolution_policy=policy,
            full_roster_simulation=full_roster,
            members_present=len(attending_member_ids) if attending_member_ids is not None else len(member_votes),
        )

    @classmethod
    def aggregate_rate_votes(
        cls, member_votes: dict[str, int], governor_id: str,
        valid_actions: Sequence[int] = RATE_ACTIONS_BPS, *, full_roster: bool = True,
        deputy_governor_id: Optional[str] = None, attending_member_ids: Optional[Sequence[str]] = None,
        fragmentation_policy: str = "reject", prior_action: int = 0,
    ) -> AggregationResult:
        return cls._aggregate(member_votes, governor_id, valid_actions, kind="rate",
                              full_roster=full_roster, deputy_governor_id=deputy_governor_id,
                              attending_member_ids=attending_member_ids,
                              fragmentation_policy=fragmentation_policy, prior_action=prior_action)

    @classmethod
    def aggregate_stance_votes(
        cls, member_votes: dict[str, str], governor_id: str,
        valid_stances: Sequence[str] = STANCE_ACTIONS, *, full_roster: bool = True,
        deputy_governor_id: Optional[str] = None, attending_member_ids: Optional[Sequence[str]] = None,
        fragmentation_policy: str = "reject", prior_action: Optional[str] = None,
    ) -> AggregationResult:
        return cls._aggregate(member_votes, governor_id, valid_stances, kind="stance",
                              full_roster=full_roster, deputy_governor_id=deputy_governor_id,
                              attending_member_ids=attending_member_ids,
                              fragmentation_policy=fragmentation_policy, prior_action=prior_action)
"""Strict simulator outputs. Invalid provider decisions are never silently repaired."""

from typing import Literal, Optional, Any
from collections import Counter
from datetime import date
from pydantic import BaseModel, Field, ConfigDict, field_validator, model_validator

from src.schemas.decision_space import RATE_ACTIONS_BPS, STANCE_ACTIONS, RateActionBps, StanceType, validate_rate_action

VALID_ACTIONS_BPS = RATE_ACTIONS_BPS


class StrictRoundOutput(BaseModel):
    model_config = ConfigDict(extra="forbid", strict=True, validate_assignment=True)
    member_id: str = Field(min_length=1)
    fallback_triggered: bool = False

    @field_validator("*", mode="after")
    @classmethod
    def nonempty_text(cls, value):
        if isinstance(value, str) and not value.strip():
            raise ValueError("Identity and rationale text cannot be whitespace only")
        return value


class InitialStanceOutput(StrictRoundOutput):
    member_name: str = Field(min_length=1)
    proposed_rate_change_bps: RateActionBps
    proposed_stance: StanceType
    key_rationale: str = Field(min_length=1)
    _rate_domain = field_validator("proposed_rate_change_bps", mode="before")(validate_rate_action)


class DeliberationOutput(StrictRoundOutput):
    round_number: Literal[2, 3]
    current_rate_preference_bps: RateActionBps
    current_stance_preference: StanceType
    rebuttal_or_critique: str = Field(min_length=1)
    open_to_compromise: bool = False
    _rate_domain = field_validator("current_rate_preference_bps", mode="before")(validate_rate_action)

    @field_validator("round_number", mode="before")
    @classmethod
    def strict_round(cls, value: object) -> int:
        if type(value) is not int or value not in (2, 3):
            raise ValueError("Deliberation round must be integer 2 or 3")
        return value


class FinalVoteOutput(StrictRoundOutput):
    member_name: str = Field(min_length=1)
    is_internal: bool = True
    final_rate_vote_bps: RateActionBps
    final_stance_vote: StanceType
    dissenting_on_rate: bool = False
    dissenting_on_stance: bool = False
    official_statement_rationale: str = Field(min_length=1)
    _rate_domain = field_validator("final_rate_vote_bps", mode="before")(validate_rate_action)


def validate_member_output(
    output: StrictRoundOutput, *, member_id: str, round_number: int,
    member_name: Optional[str] = None, is_internal: Optional[bool] = None,
) -> StrictRoundOutput:
    """Bind output to its expected request; revalidate even manually mutated models."""
    schema = {1: InitialStanceOutput, 2: DeliberationOutput, 3: DeliberationOutput, 4: FinalVoteOutput}.get(round_number)
    if schema is None or not isinstance(output, schema):
        raise ValueError(f"Unexpected output schema for Round {round_number}")
    validated = schema.model_validate(output.model_dump())
    if validated.member_id != member_id:
        raise ValueError(f"Output member_id {validated.member_id!r} differs from requested {member_id!r}")
    if isinstance(validated, DeliberationOutput) and validated.round_number != round_number:
        raise ValueError(f"Output round differs from requested Round {round_number}")
    if member_name is not None and getattr(validated, "member_name", member_name) != member_name:
        raise ValueError("Output member_name differs from the requested member")
    if is_internal is not None and getattr(validated, "is_internal", is_internal) != is_internal:
        raise ValueError("Output institutional role differs from the requested member")
    if validated.fallback_triggered:
        raise ValueError("Heuristic fallback is not permitted as research generation")
    return validated


class MeetingCommitteeDecision(BaseModel):
    """Simulator outcome and declared information/voting assumptions and evidence labels."""
    model_config = ConfigDict(extra="forbid", validate_assignment=True, strict=True)
    meeting_date: str
    replicate_id: int = Field(ge=1)
    rate_decision_bps: RateActionBps
    stance_decision: StanceType
    rate_vote_tally: dict[int, int]
    stance_vote_tally: dict[str, int]
    tie_broken_by_governor_rate: bool
    tie_broken_by_governor_stance: bool
    dissenting_members_rate: list[str]
    dissenting_members_stance: list[str]
    member_votes: list[FinalVoteOutput]
    fallbacks_count: int = Field(default=0, ge=0)
    prior_stance: Optional[StanceType] = None
    experiment_id: str = "legacy"
    condition_id: str = "full"
    control_mode: Literal["full", "earlier_rounds", "independent"] = "full"
    visibility: dict[str, Any] = Field(default_factory=dict)
    seed_schedule: dict[str, int] = Field(default_factory=dict)
    seed_schedule_version: str = "paired-member-round-v1"
    seed_base: int = 42
    governor_id: Optional[str] = None
    snapshot_hash: Optional[str] = Field(default=None, pattern=r"^[0-9a-f]{64}$")
    persona_hash: Optional[str] = Field(default=None, pattern=r"^[0-9a-f]{64}$")
    generation_settings: dict[str, Any] = Field(default_factory=dict)
    generation_count: int = Field(default=0, ge=0)
    evidence_types: list[str] = Field(default_factory=list)
    input_track: str = "legacy_unverified"
    full_roster_simulation: bool = True
    rate_resolution_policy: str = "unspecified_legacy"
    stance_resolution_policy: str = "unspecified_legacy"
    synthetic_resolution_rate: bool = False
    synthetic_resolution_stance: bool = False
    fragmentation_policy: Literal["reject", "legacy_synthetic", "status_quo"] = "reject"
    _rate_domain = field_validator("rate_decision_bps", mode="before")(validate_rate_action)

    @field_validator("meeting_date")
    @classmethod
    def real_date(cls, value):
        if date.fromisoformat(value).isoformat() != value:
            raise ValueError("Meeting date must be a real ISO calendar day")
        return value

    @field_validator("replicate_id", mode="before")
    @classmethod
    def strict_replicate(cls, value):
        if type(value) is not int or value < 1:
            raise ValueError("Replicate must be a positive integer")
        return value

    @field_validator("rate_vote_tally", "stance_vote_tally", mode="before")
    @classmethod
    def strict_tally(cls, value, info):
        if not isinstance(value, dict) or not value:
            raise ValueError("Vote tally must be a nonempty dictionary")
        normalized = {}
        for action, count in value.items():
            if type(count) is not int or count < 1:
                raise ValueError("Tally counts must be positive integers")
            if info.field_name == "rate_vote_tally":
                # JSON object keys are strings; only canonical action spellings are accepted.
                if isinstance(action, str):
                    try:
                        parsed = int(action)
                    except ValueError as exc:
                        raise ValueError("Unknown rate tally action") from exc
                    if str(parsed) != action:
                        raise ValueError("Noncanonical rate tally action")
                    validate_rate_action(parsed)
                    action = parsed
                else:
                    validate_rate_action(action)
            elif action not in STANCE_ACTIONS:
                raise ValueError("Unknown stance tally action")
            if action in normalized:
                raise ValueError("Duplicate canonical vote-tally action")
            normalized[action] = count
        return normalized

    @model_validator(mode="after")
    def reconcile_ballots(self):
        if sum(self.rate_vote_tally.values()) != sum(self.stance_vote_tally.values()):
            raise ValueError("Rate and stance tally voter counts differ")
        for winner, synthetic, tally in (
            (self.rate_decision_bps, self.synthetic_resolution_rate, self.rate_vote_tally),
            (self.stance_decision, self.synthetic_resolution_stance, self.stance_vote_tally),
        ):
            if not synthetic and winner not in tally:
                raise ValueError("Nonsynthetic decision must be one of the supplied ballots")
        if (len(self.dissenting_members_rate) != len(set(self.dissenting_members_rate))
                or len(self.dissenting_members_stance) != len(set(self.dissenting_members_stance))):
            raise ValueError("Duplicate dissent labels")
        for tied, synthetic, tally in (
            (self.tie_broken_by_governor_rate, self.synthetic_resolution_rate, self.rate_vote_tally),
            (self.tie_broken_by_governor_stance, self.synthetic_resolution_stance, self.stance_vote_tally),
        ):
            if tied and (synthetic or len(tally) != 2 or len(set(tally.values())) != 1):
                raise ValueError("Casting flag must represent binary equality, not synthetic fragmentation")
        if self.member_votes:
            if self.full_roster_simulation and len(self.member_votes) != 6:
                raise ValueError("Full-roster decision requires six member ballots")
            if len({v.member_id for v in self.member_votes}) != len(self.member_votes):
                raise ValueError("Duplicate member ballots")
            rates = dict(Counter(v.final_rate_vote_bps for v in self.member_votes))
            stances = dict(Counter(v.final_stance_vote for v in self.member_votes))
            if rates != self.rate_vote_tally or stances != self.stance_vote_tally:
                raise ValueError("Tallies do not match supplied member ballots")
            rate_dissent = {v.member_id for v in self.member_votes if v.final_rate_vote_bps != self.rate_decision_bps}
            stance_dissent = {v.member_id for v in self.member_votes if v.final_stance_vote != self.stance_decision}
            if rate_dissent != set(self.dissenting_members_rate) or stance_dissent != set(self.dissenting_members_stance):
                raise ValueError("Dissent labels do not match supplied member ballots")
            if any(v.dissenting_on_rate != (v.member_id in rate_dissent)
                   or v.dissenting_on_stance != (v.member_id in stance_dissent) for v in self.member_votes):
                raise ValueError("Member dissent flags do not match supplied ballots")
            if self.governor_id is not None:
                from src.rule_engine.engine import InstitutionalRuleEngine
                rate = InstitutionalRuleEngine.aggregate_rate_votes(
                    {v.member_id: v.final_rate_vote_bps for v in self.member_votes}, self.governor_id,
                    full_roster=self.full_roster_simulation, fragmentation_policy=self.fragmentation_policy, prior_action=0)
                stance = InstitutionalRuleEngine.aggregate_stance_votes(
                    {v.member_id: v.final_stance_vote for v in self.member_votes}, self.governor_id,
                    full_roster=self.full_roster_simulation, fragmentation_policy=self.fragmentation_policy, prior_action=self.prior_stance)
                for result, winner, casting, synthetic, policy in (
                    (rate, self.rate_decision_bps, self.tie_broken_by_governor_rate, self.synthetic_resolution_rate, self.rate_resolution_policy),
                    (stance, self.stance_decision, self.tie_broken_by_governor_stance, self.synthetic_resolution_stance, self.stance_resolution_policy),
                ):
                    if (result.winning_action != winner or result.tie_broken_by_governor != casting
                            or result.synthetic_resolution != synthetic or result.resolution_policy != policy):
                        raise ValueError("Committee decision or resolution metadata differs from declared voting rule")
            if self.generation_count or self.seed_schedule:
                rounds = (1, 4) if self.control_mode == "independent" else (1, 2, 3, 4)
                expected_seeds = {f"{v.member_id}:round_{r}" for v in self.member_votes for r in rounds}
                if self.generation_count != len(expected_seeds) or set(self.seed_schedule) != expected_seeds:
                    raise ValueError("Generation count or seed keys differ from declared protocol")
        return self
"""
Open-Economy Smoothed Taylor Rule Engine for the Rational Benchmark Track.
Calculates implied nominal policy rate with central bank interest-rate inertia,
inflation gap, output gap, and external US Federal Reserve interest rate differential.
"""

from dataclasses import dataclass
from typing import Sequence
import math
from src.schemas.macro_schema import MacroMeetingSnapshot
from src.schemas.decision_space import RATE_ACTIONS_BPS


@dataclass
class MemberTaylorParameters:
    """Taylor coefficients; fitting/assumption provenance is supplied by the study."""
    member_id: str
    alpha: float = 1.5   # Inflation gap sensitivity
    beta: float = 0.5    # Output gap sensitivity
    gamma: float = 0.2   # US Fed rate differential sensitivity

    def __post_init__(self):
        if not self.member_id or not all(math.isfinite(x) for x in (self.alpha, self.beta, self.gamma)):
            raise ValueError("Taylor parameters require a member ID and finite coefficients")


class SmoothedTaylorRule:
    """
    Implements:
    r*_t = r_star + pi_t + alpha_i * (pi_t - pi_target) + beta_i * output_gap + gamma_i * (i_us - i_us_target)
    r_t = rho * r_{t-1} + (1 - rho) * r*_t
    """

    def __init__(
        self,
        r_star_pct: float = 1.4,
        pi_star_pct: float = 4.0,
        smoothing_rho: float = 0.75,
        us_neutral_rate_pct: float = 2.5,
        action_set_bps: Sequence[int] = RATE_ACTIONS_BPS,
    ):
        if not all(math.isfinite(x) for x in (r_star_pct, pi_star_pct, smoothing_rho, us_neutral_rate_pct)):
            raise ValueError("Taylor settings must be finite")
        if not 0 <= smoothing_rho < 1:
            raise ValueError("Taylor smoothing must be in [0,1)")
        if not action_set_bps or len(set(action_set_bps)) != len(action_set_bps) or any(type(x) is not int or x not in RATE_ACTIONS_BPS for x in action_set_bps):
            raise ValueError("Invalid Taylor action domain")
        self.r_star = r_star_pct
        self.pi_star = pi_star_pct
        self.rho = smoothing_rho
        self.us_neutral_rate = us_neutral_rate_pct
        self.action_set_bps = action_set_bps

    def compute_continuous_rate(
        self,
        snapshot: MacroMeetingSnapshot,
        params: MemberTaylorParameters,
    ) -> float:
        """Computes the target nominal policy rate before discretization."""
        # Inflation gap: pi_t - pi*
        inflation_gap = snapshot.cpi_headline_yoy_pct - self.pi_star
        # Output gap: y_t - y*
        if params.beta != 0 and snapshot.output_gap_pct is None:
            raise ValueError("Open-economy Taylor benchmark requires a sourced output gap; beta=0 is a reduced-input sensitivity")
        output_gap = snapshot.output_gap_pct if snapshot.output_gap_pct is not None else 0.0
        # External US Fed rate gap
        if params.gamma != 0 and snapshot.us_fed_funds_rate_pct is None:
            raise ValueError("Open-economy Taylor benchmark requires a sourced Fed target; gamma=0 is a reduced-input sensitivity")
        us_rate_gap = snapshot.us_fed_funds_rate_pct - self.us_neutral_rate if snapshot.us_fed_funds_rate_pct is not None else 0.0

        # Unsmoothed Taylor target: r* + pi_t + alpha*(pi - pi*) + beta*gap + gamma*us_gap
        target_rate = (
            self.r_star
            + snapshot.cpi_headline_yoy_pct
            + params.alpha * inflation_gap
            + params.beta * output_gap
            + params.gamma * us_rate_gap
        )

        # Apply interest rate smoothing with previous rate
        prev_rate = snapshot.current_repo_rate_pct
        smoothed_rate = self.rho * prev_rate + (1.0 - self.rho) * target_rate
        return smoothed_rate

    def compute_discrete_action(
        self,
        snapshot: MacroMeetingSnapshot,
        params: MemberTaylorParameters,
    ) -> tuple[int, str]:
        """
        Discretizes the implied continuous rate into the nearest valid basis point action
        and assigns an implied policy stance.
        Returns: (vote_bps, stance_string)
        """
        smoothed_rate = self.compute_continuous_rate(snapshot, params)
        raw_change_bps = (smoothed_rate - snapshot.current_repo_rate_pct) * 100.0

        # Discretize to closest action in action set
        discrete_vote_bps = min(self.action_set_bps, key=lambda a: abs(a - raw_change_bps))

        # Implied stance
        if discrete_vote_bps > 0 or snapshot.cpi_headline_yoy_pct > (self.pi_star + 1.0):
            implied_stance = "withdrawal_of_accommodation"
        elif discrete_vote_bps < 0 and snapshot.cpi_headline_yoy_pct < self.pi_star:
            implied_stance = "accommodative"
        else:
            implied_stance = "neutral"

        return int(discrete_vote_bps), implied_stance
"""Strong, reproducible historical baselines; only published prior truth is usable."""
from collections import Counter
from datetime import date
import hashlib
import json
from src.validation.metrics import MetricsEvaluator


def fit_dissent_baseline(calibration_truth, cutoff="2023-04-06", *, information_cutoff="2023-04-30"):
    if date.fromisoformat(cutoff).isoformat() != cutoff or date.fromisoformat(information_cutoff).isoformat() != information_cutoff:
        raise ValueError('Baseline cutoffs must be ISO calendar dates')
    if not calibration_truth or any(row['meeting_date'] > cutoff for row in calibration_truth):
        raise ValueError('Holdout or empty truth in calibration')
    if len({row['meeting_date'] for row in calibration_truth}) != len(calibration_truth):
        raise ValueError('Duplicate calibration meeting')
    for row in calibration_truth:
        meeting, publication = date.fromisoformat(row['meeting_date']), date.fromisoformat(row['publication_date'])
        if publication < meeting or row['publication_date'] >= information_cutoff:
            raise ValueError('Calibration labels are unavailable at the declared selection freeze')
    result = {'cutoff': cutoff, 'information_cutoff':information_cutoff,
              'method': 'best constant dissent set per channel by calibration F1 then exact-match',
              'selection_status': 'calibration only; cohort-specific',
              'calibration_hash': hashlib.sha256(json.dumps(calibration_truth, sort_keys=True).encode()).hexdigest()}
    for channel in ('rate_dissenters', 'stance_dissenters'):
        candidates = sorted({tuple(sorted(row[channel])) for row in calibration_truth})
        truth = [row[channel] for row in calibration_truth]
        scored = []
        for candidate in candidates:
            precision, recall, f1, exact = MetricsEvaluator.compute_dissent_f1([candidate] * len(truth), truth)
            scored.append((f1 if f1 is not None else -1, exact, candidate))
        # Lexical tie-break is predetermined and recorded; no evaluation labels used.
        result[channel] = list(max(scored, key=lambda item: (item[0], item[1], tuple(item[2])))[2])
    return result


def baseline_predictions(snapshots, truth, frozen_dissent):
    by_date = {row['meeting_date']: row for row in truth}
    if len(by_date) != len(truth):
        raise ValueError('Duplicate truth meeting')
    rows = []
    for snapshot in snapshots:
        # Entire minutes publication day precedes the meeting-start cutoff.
        cutoff = snapshot.information_cutoff.date().isoformat() if snapshot.information_cutoff else snapshot.meeting_date
        available = sorted([r for r in truth if r['publication_date'] < cutoff], key=lambda r:r['meeting_date'])
        prior = available[-1] if available else None
        for name in ('hold_previous_stance', 'lag_persistence', 'calibration_constant_dissent'):
            rate = prior['actual_rate_bps'] if name == 'lag_persistence' and prior else 0
            stance = prior['actual_stance'] if name == 'lag_persistence' and prior else snapshot.prev_stance
            rate_dissent = prior['rate_dissenters'] if name == 'lag_persistence' and prior else []
            stance_dissent = prior['stance_dissenters'] if name == 'lag_persistence' and prior else []
            if name == 'calibration_constant_dissent':
                if snapshot.meeting_date <= frozen_dissent['cutoff'] or cutoff < frozen_dissent['information_cutoff']:
                    raise ValueError('Fitted baseline evaluated inside calibration')
                rate_dissent, stance_dissent = frozen_dissent['rate_dissenters'], frozen_dissent['stance_dissenters']
            rows.append({'meeting_date':snapshot.meeting_date, 'baseline':name, 'rate_bps':rate,
                         'stance':stance, 'rate_dissenters':list(rate_dissent), 'stance_dissenters':list(stance_dissent),
                         'source_prior_meeting':prior['meeting_date'] if prior else None,
                         'evidence_type':'deterministic_baseline'})
    return rows
