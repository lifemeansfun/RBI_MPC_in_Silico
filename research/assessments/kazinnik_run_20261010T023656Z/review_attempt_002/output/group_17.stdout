"""Reconstruct tables from complete saved evidence without any model generation.

Hashes are consistency checks, not source signatures. Replaying an experiment is
not an independent replication of its provider calls or empirical performance.
"""
from collections import Counter
from contextlib import contextmanager
from pathlib import Path
import base64
import json
import tempfile

import pandas as pd

from src.backtest.backtest_runner import BacktestRunner
from src.backtest.study_artifacts import strict_json, read_inputs, verify_observation_bundle
from src.behavioral.debate_orchestrator import planned_seed
from src.infra.checkpoint import CheckpointStore
from src.infra.evidence import content_hash, file_hash, safe_component, write_immutable
from src.infra.exceptions import ArtifactIntegrityError
from src.infra.transcript_logger import read_transcript
from src.persona_engine.provenance import verify_personas
from src.rule_engine.engine import InstitutionalRuleEngine
from src.schemas.macro_schema import MacroMeetingSnapshot
from src.schemas.persona_schema import MemberPersona
from src.schemas.debate_schema import (InitialStanceOutput, DeliberationOutput,
                                      FinalVoteOutput, MeetingCommitteeDecision)

ROUND_SCHEMAS = {1: InitialStanceOutput, 2: DeliberationOutput, 3: DeliberationOutput, 4: FinalVoteOutput}
ENVELOPE = {'artifact_identity', 'artifact_content_hash', 'generation', 'prompt'}


def require(condition, message):
    if not condition:
        raise ArtifactIntegrityError(message)


@contextmanager
def portable_sources(sources):
    with tempfile.TemporaryDirectory(prefix='rbi-replay-sources-') as directory:
        root = Path(directory)
        for name, record in sources.items():
            path = root / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(base64.b64decode(record['bytes'], validate=True))
        yield root


def replay_study(study_dir, output_dir, *, expected_manifest_hash):
    """Require a separately retained manifest anchor; output must be a fresh directory."""
    study_dir, output_dir = Path(study_dir).resolve(), Path(output_dir).resolve()
    require(not output_dir.exists(), 'Replay output must be an unused directory')
    manifest = strict_json(study_dir / 'study_manifest.json')
    require(content_hash(manifest) == expected_manifest_hash, 'Study manifest differs from supplied anchor')
    version = manifest.get('study_manifest_version')
    require(type(version) is int and version in (2,3), 'Unsupported or incomplete study manifest')
    threshold_contract = 'union_v1' if version == 2 else manifest.get('metric_threshold_contract')
    require(threshold_contract == ('union_v1' if version == 2 else 'channel_v2'),
            'Study metric threshold contract is unsupported')
    experiment, condition = study_dir.parent.name, study_dir.name
    safe_component(experiment); safe_component(condition)
    require(condition == manifest['condition'], 'Condition directory differs from manifest')
    inputs = read_inputs(study_dir / 'inputs', manifest['frozen_inputs_hashes'])
    snapshots = [MacroMeetingSnapshot.model_validate(row) for row in inputs['snapshots.json']]
    dates = [s.meeting_date for s in snapshots]
    require(dates and dates == sorted(set(dates)) and dates == manifest['meetings'], 'Invalid chronological snapshot join')
    truths = inputs['truth.json']
    require([t['meeting_date'] for t in truths] == dates, 'Truth and snapshot joins differ')
    truth_by_date = {t['meeting_date']: t for t in truths}
    persona_map = {m: MemberPersona.model_validate(p) for m, p in inputs['personas.json'].items()}
    require(all(m == p.member_id for m, p in persona_map.items()), 'Frozen persona mapping impersonates members')
    roster = manifest['roster_by_meeting']
    require(set(roster) == set(dates), 'Incomplete dated roster')
    with portable_sources(inputs['raw_sources.json']) as sources:
        for snapshot in snapshots:
            require(len(roster[snapshot.meeting_date]) == 6 and len(set(roster[snapshot.meeting_date])) == 6,
                    'Each simulator roster requires six distinct members')
            verify_observation_bundle(snapshot, inputs['raw_sources.json'])
            if manifest['source_validation_required']:
                snapshot.verify_sources(sources)
                verify_personas([persona_map[m] for m in roster[snapshot.meeting_date]],
                                snapshot.information_cutoff, source_root=sources)
                truth = truth_by_date[snapshot.meeting_date]
                require(truth['source_file'] in inputs['raw_sources.json'] and
                        inputs['raw_sources.json'][truth['source_file']]['sha256'] == truth['source_sha256'],
                        'Historical truth lacks its retained source bytes')
    nrep = manifest['n_replicates']
    require(type(nrep) is int and nrep > 0, 'Invalid planned replicate count')
    pairs = {(day, rep) for day in dates for rep in range(1, nrep + 1)}
    settings = manifest['generation_settings']
    interventions = {'control_mode':manifest['control'], 'mask_identity':manifest['mask_identity'],
                     'mask_date':manifest['mask_date'], 'fragmentation_policy':manifest['fragmentation_policy']}
    checkpoints = {}
    checkpoint_store = CheckpointStore(study_dir.parents[1])
    for path in sorted((study_dir / 'checkpoints').glob('*.json')):
        preliminary = strict_json(path)
        identity = preliminary['identity']
        pair = identity['meeting_date'], identity['replicate_id']
        require(pair in pairs and pair not in checkpoints, 'Duplicate, stale or unexpected checkpoint')
        day, rep = pair
        snapshot = snapshots[dates.index(day)]
        members = [persona_map[m] for m in roster[day]]
        expected = {'experiment_id':experiment, 'condition_id':condition, 'meeting_date':day, 'replicate_id':rep,
            'code_hash':manifest['code_hash'], 'config_hash':content_hash(inputs['config.json']),
            'data_hash':content_hash(snapshot.model_dump(mode='json')), 'persona_hash':content_hash([p.model_dump() for p in members]),
            'intervention_hash':content_hash(interventions), 'seed_schedule_version':'paired-member-round-v1',
            'seed_base':manifest['seed_base'], 'requested_model':manifest['model'], 'provider':manifest['provider'],
            'temperature':manifest['temperature'], 'model_epoch':inputs['config.json']['run']['model_epoch'],
            'max_output_tokens':inputs['config.json']['run']['max_output_tokens'], 'truth_hash':manifest['truth_hash'],
            'generation_settings_hash':content_hash(settings), 'snapshot_hash':content_hash(snapshot.model_dump(mode='json')),
            'study_manifest_hash':expected_manifest_hash}
        require(identity == expected, 'Checkpoint scientific identity differs from frozen inputs')
        require(path == checkpoint_store.path_for(expected), 'Checkpoint filename does not encode its identity')
        saved = checkpoint_store.load(expected)
        require(saved is not None, 'Missing expected checkpoint')
        checkpoints[pair] = saved
    require(set(checkpoints) == pairs, 'Incomplete meeting or replicate evidence')
    records, evidence_counts, cost = [], Counter(), 0.0
    for day in dates:
        snapshot = snapshots[dates.index(day)]
        member_ids = roster[day]
        for rep in range(1, nrep + 1):
            saved = checkpoints[day, rep]
            identity = saved['identity']
            rounds = [1, 4] if manifest['control'] == 'independent' else [1, 2, 3, 4]
            required = {f'round_{r}_{m}.json' for r in rounds for m in member_ids} | {'meeting_outcome.json'}
            require(set(saved['artifacts']) == required, 'Missing, extra or mismatched round artifacts')
            outputs, local_types, seeds = {}, set(), {}
            for r in rounds:
                for member in member_ids:
                    key = f'round_{r}_{member}.json'
                    artifact = saved['artifacts'][key]
                    document = read_transcript(checkpoint_store.output_root / artifact['path'],
                                               {**identity, 'round_number':r, 'member_id':member})
                    generation = document['generation']
                    parsed = ROUND_SCHEMAS[r].model_validate(generation['parsed']).model_dump(mode='json')
                    aliases = document['prompt'].get('identity_aliases', {})
                    if manifest['mask_identity']:
                        require(parsed['member_id'] == aliases.get(member), 'Masked member alias differs from plan')
                        parsed['member_id'] = member
"""Durable pre-submission budget accounting, with conservative unresolved charges.

Costs are estimates at a versioned public tariff, not authenticated invoices.
Only text-only Gemini Standard calls without tools are supported by this tariff.
"""

import json
import math
import os
import socket
import sqlite3
import tempfile
import uuid
from contextlib import contextmanager
from decimal import Decimal, ROUND_CEILING
from pathlib import Path
from typing import Optional

from src.infra.evidence import canonical_json, write_immutable
from src.infra.exceptions import (
    ArtifactIntegrityError, BudgetExceededError, BudgetLedgerError, GenerationProvenanceError,
    UncertainChargeError, UnknownPriceError,
)

PROJECT_ROOT = Path(__file__).resolve().parents[2]
PRICE_REVISION = "google-gemini-standard-text-2026-10-05"
PRICE_SOURCE = "https://ai.google.dev/gemini-api/docs/pricing#gemini-3.1-flash-lite"
# Verified from Google's Gemini Developer API pricing, Standard, 2026-10-05.
TOKEN_RATES_PER_MILLION = {
    "gemini-3.1-flash-lite": {"input": 0.25, "output": 1.50},
    "mock": {"input": 0.0, "output": 0.0},
}
_NANO = Decimal(1_000_000_000)


def _tokens(value: int, label: str, *, positive: bool = False) -> int:
    if type(value) is not int or value < (1 if positive else 0):
        raise GenerationProvenanceError(f"{label} must be a {'positive' if positive else 'nonnegative'} integer")
    return value


def _nanos(value: float) -> int:
    if not math.isfinite(value) or value < 0:
        raise BudgetLedgerError("Budget/cost must be finite and nonnegative")
    return int((Decimal(str(value)) * _NANO).to_integral_value(rounding=ROUND_CEILING))


def _cost_nanos(model: str, input_tokens: int, output_tokens: int) -> int:
    if model not in TOKEN_RATES_PER_MILLION:
        raise UnknownPriceError(f"No verified price for model {model!r}")
    rates = TOKEN_RATES_PER_MILLION[model]
    value = (Decimal(input_tokens) * Decimal(str(rates["input"]))
             + Decimal(output_tokens) * Decimal(str(rates["output"]))) / Decimal(1_000_000)
    return int((value * _NANO).to_integral_value(rounding=ROUND_CEILING))


class CostGovernor:
    """SQLite transactions share one hard cap across threads and processes.

    Pass a study-specific ledger_path in research. The no-path constructor creates
    an isolated durable temporary ledger for backwards-compatible component use.
    get_governor() instead selects the shared corrected-study default path.
    """

    def __init__(self, budget_cap_usd: float = 25.0, ledger_path: str | Path | None = None):
        self.budget_cap_usd = budget_cap_usd
        self._cap_nanos = _nanos(budget_cap_usd)
        self.ledger_path = Path(ledger_path) if ledger_path is not None else (
            Path(tempfile.mkdtemp(prefix="rbi-budget-")) / "budget.sqlite"
        )
        self.ledger_path.parent.mkdir(parents=True, exist_ok=True)
        self.initialization_path = self.ledger_path.with_name(self.ledger_path.name + ".initialized.json")
        initialization = {"ledger_filename": self.ledger_path.name, "cap_nanos": self._cap_nanos, "schema_version": 1}
        previously_initialized = self.initialization_path.exists()
        if previously_initialized:
            try:
                recorded = json.loads(self.initialization_path.read_text(encoding="utf-8"))
                if canonical_json(recorded) != canonical_json(initialization) or not self.ledger_path.is_file():
                    raise BudgetLedgerError("Previously initialized ledger is missing or its identity changed; do not reset accounting")
            except (OSError, ValueError, TypeError, GenerationProvenanceError) as exc:
# Frozen one-call comparator contracts

This is an engineering contract for two future comparative conditions. It supplies no paid model observations, forecast superiority result, validated persona construct or publication-grade verdict. Existing study manifests and `MeetingCommitteeDecision.control_mode` values are untouched; integration into a newly frozen study remains required.

`src/behavioral/comparator_forecasters.py` implements a single joint forecast of exact committee rate change, stance and all six formal member ballots. `joint_persona` receives the same macro prompt and the union of the six `MemberPersona.build_system_prompt` texts used for initial panel generation. `macro_only` receives that macro prompt and the explicit ordered membership, institutional roles and Governor identity, but rejects supplied persona profiles. Its structural roster information is a declared institutional assumption, not a learned person-specific preference. Neither condition receives generated peer arguments. Historical outcomes in compatibility snapshot fields stay out of both prompts.

The full six-member panel uses 24 calls and its independent control 12; these comparators use one generation request. Token bounds are reservations, actual recorded token counts retain their usage source, and cost from those counts remains an estimate under the recorded price revision. Cache replay is zero new model submissions and retains its original evidence type; deterministic mock JSON is fixture evidence. Conditions are expressly **not budget matched**. A scientific comparison must freeze its resource policy and report both prediction and resource outcomes rather than attribute a difference solely to deliberation.

## Additive interface

```python
roster = ComparatorRoster(
    version="explicit_roster_version", valid_from="YYYY-MM-DD",
    valid_through="YYYY-MM-DD", governor_id="declared_id",
    members=tuple(RosterMember(member_id=..., member_name=..., role=...,
                               is_internal=...) for ...),
    stance_vocabulary_version="simulator_stance_v1",
)
control = ComparatorForecaster(client, condition_logger,
                               source_root=scientific_source_root,
                               corpus_manifest_path=dated_corpus_manifest)
request = control.freeze(
    snapshot, roster, mode="joint_persona", personas=ordered_profiles,
    experiment_id=..., condition_id=..., replicate_id=1,
    model=..., temperature=..., seed=..., max_output_tokens=...,
    model_epoch=..., mask_date=False, mask_identity=False,
    fragmentation_policy="reject",
)
record = await control.generate(request)
```

For `macro_only`, pass an empty persona sequence. The logger must already carry the intended experiment and condition identities. Expanded rosters must be explicitly supplied with bounded dates and version; no original roster is silently reused. Only the current seven rate actions and the three stances in `simulator_stance_v1` are supported. A later stance such as `calibrated_tightening` or an unsupported ontology rejects until a separate versioned schema and scoring contract exist. This vocabulary limitation prevents claiming all expanded meetings are currently runnable.

Freeze writes immutable request bytes and hashes the supplied snapshots, roster, full persona profiles, source evidence files, dated corpus manifests and source statements, generation settings and relevant project code. Before generation it rechecks both retained object references and file hashes. Dated corpus profiles are verified even for a mock probe; live generation requires source-linked macro observations and verified, available persona corpora for `joint_persona`. Counterfactual inputs require a retained parent and exact declared changes. Normal calendar dates, exclusive release cutoffs, finite values and source hashes use the existing schemas and provenance validators.

Identity masking uses the panel's exact ordered mapping `member_i` / `Simulated Member i`. Named persona IDs and names are replaced throughout the supplied initial prompts. Source filenames and corpus IDs do not enter these prompts. Date masking uses the same macro availability-lag treatment and calendar-label replacement as the panel. Neither prompt instructions nor text masks establish absence of latent model contamination or unguessable identity.

## Targets, failure and replay semantics

The structured response predicts committee exact rate/stance and six member ballots in the declared order. `rate_choice_disagreement` means predicted exact member rate differs from the predicted committee rate; `formal_stance_dissent` means the predicted formal stance ballot differs from committee stance. Reservations, argument disagreements, guidance disagreement and literal Yes/No ballot cells are distinct constructs, not these flags. Unknown real labels must still remain unknown during observed-target scoring.

Committee predictions and both dissent flags must agree with the same declared institutional resolver as the panel. Ordinary majority and binary 3:3 Governor casting remain distinct from synthetic fragmentation. Default fragmentation rejects unresolved ballots. Explicit `status_quo` or `legacy_synthetic` policies retain their synthetic resolution fields. This consistency constraint means the control forecasts simulated ballots and an aggregate committee outcome, rather than independently guessing two contradictory targets.

Generation uses the actual `LLMClient.generate_with_metadata`, normalized `request_identity`, canonical request payload and immutable `GenerationResult`/`GenerationMetadata`; this code does not invent a `GenerationRequest` type or a synthetic live receipt. There is one submission attempt, with no automatic repair, model substitution or retry. Budget, uncertain-charge, malformed output, provenance and cancellation failures propagate. Failure events retain the raw generation or the runtime's error context. A consumed plan cannot be resubmitted after failure; a new attempt needs a distinct declared identity and preserved prior evidence.

The original transcript retains nested alias outputs without modifying the runtime evidence schema. The derived comparator record separately normalizes member IDs and validates every normalized ballot against the anchored original generation. `read_comparator_record(path, expected_plan_hash=...)` requires an externally retained frozen-plan hash and checks raw schema, request/prompt/model/settings identity, committee resolution, dissent channels, derived prediction, recorded usage and complete retained transcript bytes. An explicit `transcript_path=...` maps an archived/copied transcript location while still requiring its exact stored hash and generation identity. Hash validation checks internal consistency; it does not authenticate a provider invoice or turn a replay into fresh live evidence.

## Verification scope

Dedicated tests in `tests/test_comparator_forecasters.py` run scripted JSON through the actual offline runtime. They probe both controls, paired masks and raw alias replay, zero additional submission on frozen input/source/settings mutations, invalid roster/date/ontology, wrong exact committee outcomes, channel contradictions, unresolved and synthetic ballots, strict malformed fields, rehashed corruption and terminal budget/cancellation errors. Tests use isolated output destinations. Commands, source hashes, raw logs, environment and any failed attempts are retained under distinct `results/upgrade_validation_round_002/comparator_controls_*` paths.

Scientific work still requires calibration-frozen controls and dated roster/persona selection, aligned same-information new studies, meeting-level paired uncertainty, meaningful positive and negative examples, actual repeated live generation with resource receipts, and a pre-outcome prospective freeze if claiming untouched evaluation. Passing these tests closes only the new control contract's engineering checks.
